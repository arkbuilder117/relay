<div class="max-w-sm mx-auto mt-16">
  <h1 class="text-2xl font-bold mb-6 text-center">Sign in</h1>
  <%= form_with url: session_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email, required: true, autofocus: true,
            class: "w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :password, class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password, required: true,
            class: "w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
    <%= f.submit "Sign in", class: "w-full bg-indigo-600 text-white py-2 rounded font-medium hover:bg-indigo-700 cursor-pointer" %>
  <% end %>
  <p class="text-center text-sm mt-4 text-gray-500">
    No account? <%= link_to "Sign up", new_registration_path, class: "text-indigo-600 hover:underline" %>
  </p>
</div>
