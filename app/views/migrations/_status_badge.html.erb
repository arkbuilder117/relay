<% css = case migration.status
         when "pending"     then "bg-gray-100 text-gray-700"
         when "in_progress" then "bg-blue-100 text-blue-700"
         when "completed"   then "bg-green-100 text-green-700"
         when "failed"      then "bg-red-100 text-red-700"
         end %>
<span class="px-3 py-1 rounded-full text-sm font-medium <%= css %>">
  <%= migration.status.humanize %>
</span>
