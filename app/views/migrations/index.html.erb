<% content_for :title, "Relay — Migrate your playlists" %>

<div class="text-center mb-10">
  <h1 class="text-3xl font-bold mb-2">Migrate your playlists</h1>
  <p class="text-gray-500">Move your music between Spotify and Apple Music in minutes.</p>
</div>

<%= form_with url: connect_migrations_path, method: :get,
      data: { controller: "direction" } do |f| %>

  <%= f.hidden_field :direction, value: "", data: { direction_target: "input" } %>

  <div class="grid grid-cols-2 gap-6 max-w-xl mx-auto mb-8">
    <div class="border-2 rounded-xl p-6 text-center cursor-pointer hover:border-indigo-400 transition"
         data-direction-target="card"
         data-value="spotify_to_apple"
         data-action="click->direction#select">
      <div class="text-4xl mb-3">🎵</div>
      <div class="font-semibold text-lg">Spotify</div>
      <div class="text-gray-400 text-sm my-1">→</div>
      <div class="font-semibold text-lg">Apple Music</div>
    </div>

    <div class="border-2 rounded-xl p-6 text-center cursor-pointer hover:border-indigo-400 transition"
         data-direction-target="card"
         data-value="apple_to_spotify"
         data-action="click->direction#select">
      <div class="text-4xl mb-3">🎵</div>
      <div class="font-semibold text-lg">Apple Music</div>
      <div class="text-gray-400 text-sm my-1">→</div>
      <div class="font-semibold text-lg">Spotify</div>
    </div>
  </div>

  <%= f.submit "Continue →",
        disabled: true,
        data: { direction_target: "submit" },
        class: "block mx-auto bg-indigo-600 text-white px-8 py-3 rounded-lg font-medium hover:bg-indigo-700 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer" %>
<% end %>
